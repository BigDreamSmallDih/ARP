{
  "name": "@arp/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=esm --sourcemap --outfile=dist/server.js --external:fastify --external:@modelcontextprotocol/sdk --external:zod",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@arp/agents": "*",
    "@arp/mcp": "*",
    "@arp/security": "*",
    "@arp/shared": "*",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "fastify": "^5.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0"
  }
}
