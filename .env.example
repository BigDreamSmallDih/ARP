# Copy to .env for local development. Never commit .env.
# Empty values count as unset. Generate secrets with: openssl rand -hex 32

NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Set to true only when the gateway runs behind a reverse proxy you control.
# It makes rate limits and lockouts use X-Forwarded-For. Leave false otherwise,
# because a client could forge that header.
TRUST_PROXY=false

# Bearer token for the dashboard API (/api/*). 32+ characters.
# Leave empty to disable the admin API.
GATEWAY_ADMIN_TOKEN=

# Bearer tokens MCP clients use to authenticate to the gateway, one per agent.
# 32+ characters. Every token in this file must be different.
GATEWAY_TOKEN_CHATGPT=
GATEWAY_TOKEN_CLAUDE=
GATEWAY_TOKEN_GEMINI=

# AI providers. A provider is usable only when BOTH its key and its model are set.
# There are no default models: set the model id your account can use, as shown in
# the provider's console. Keys stay on the gateway and are never sent to the dashboard.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Provider calls: timeout per request, and the most output tokens one call may request.
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_OUTPUT_TOKENS=1024

# Rate limits. Per client address: requests per minute and failed authentications
# per 15 minutes. Per calling agent: provider calls per minute.
RATE_LIMIT_PER_MINUTE=120
AUTH_FAILURE_LIMIT=10
PROVIDER_CALLS_PER_MINUTE=20

# Largest accepted request body, in bytes.
REQUEST_BODY_LIMIT_BYTES=262144

# Supabase. Set both or neither. The gateway does not connect to Supabase yet.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Origin allowed to call the gateway from a browser, for example the deployed
# dashboard. Leave empty when the dashboard is served behind the same origin.
DASHBOARD_ORIGIN=

# Session and audit limits.
SESSION_IDLE_TTL_SECONDS=1800
MAX_SESSIONS=100
MAX_SESSIONS_PER_AGENT=10
AUDIT_BUFFER_SIZE=500
